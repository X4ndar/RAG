# Copy this file to .env and fill in real values.
# Never commit .env.

# ---------- App ----------
APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=change-me-to-a-long-random-string
BACKEND_CORS_ORIGINS=http://localhost:3000

# ---------- Postgres (with pgvector) ----------
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_DB=rag
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# asyncpg driver URL, used by SQLAlchemy async engine
DATABASE_URL=postgresql+asyncpg://rag:rag@postgres:5432/rag

# ---------- Qdrant ----------
QDRANT_URL=http://qdrant:6333
# QDRANT_API_KEY=

# ---------- Redis ----------
REDIS_URL=redis://redis:6379/0

# ---------- LLM provider ----------
# ollama | claude
LLM_PROVIDER=ollama
ANTHROPIC_API_KEY=
# Ollama runs on the host; Docker Desktop exposes it via host.docker.internal
OLLAMA_HOST=http://host.docker.internal:11434

# ---------- Embeddings and reranker (later phases) ----------
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# ---------- Frontend ----------
NEXT_PUBLIC_API_BASE=http://localhost:8000

# ---------- Host port overrides ----------
# Change these if a port is already in use on your host.
FRONTEND_HOST_PORT=3000
BACKEND_HOST_PORT=8000
POSTGRES_HOST_PORT=5432
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
REDIS_HOST_PORT=6379
