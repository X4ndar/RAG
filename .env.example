# Copy this file to .env and fill in real values.
# Never commit .env.

# ---------- App ----------
APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=change-me-to-a-long-random-string
BACKEND_CORS_ORIGINS=http://localhost:3000

# ---------- Postgres (with pgvector) ----------
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_DB=rag
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# asyncpg driver URL, used by SQLAlchemy async engine
DATABASE_URL=postgresql+asyncpg://rag:rag@postgres:5432/rag

# ---------- Qdrant ----------
QDRANT_URL=http://qdrant:6333
# QDRANT_API_KEY=

# ---------- Redis ----------
REDIS_URL=redis://redis:6379/0

# ---------- LLM provider (V1.5a BYOM) ----------
# Each tenant configures their own LLM provider through the admin UI; the
# platform never ships a default provider or a platform-owned key. The
# legacy LLM_PROVIDER / ANTHROPIC_API_KEY / OLLAMA_HOST entries below are
# read by nothing in the V1.5a+ codebase and are kept only as a transition
# aid; they will be removed in V2.
#
# Master key for at-rest encryption of tenant API keys (Fernet, 32 bytes
# URL-safe base64). Generate once per environment with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Missing or malformed -> every LLM-touching endpoint returns 503.
LLM_CONFIG_MASTER_KEY=

# Legacy (unused by V1.5a; remove in V2).
LLM_PROVIDER=ollama
ANTHROPIC_API_KEY=
OLLAMA_HOST=http://host.docker.internal:11434

# ---------- Embeddings and reranker (later phases) ----------
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# ---------- Frontend ----------
NEXT_PUBLIC_API_BASE=http://localhost:8000

# ---------- Host port overrides ----------
# Change these if a port is already in use on your host.
FRONTEND_HOST_PORT=3000
BACKEND_HOST_PORT=8000
POSTGRES_HOST_PORT=5432
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
REDIS_HOST_PORT=6379
